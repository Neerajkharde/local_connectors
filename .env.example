# SAP S/4HANA Connection
SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud
SAP_API_KEY=
SAP_USERNAME=
SAP_PASSWORD=
# Auth mode: "apikey" (APIKey header - REQUIRED for the SAP API Business Hub sandbox),
#            "basic"  (HTTP Basic, for on-premise / BTP systems) or "none".
SAP_AUTH_MODE=apikey

# PostgreSQL Connection
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=

# Extraction limits (max records per run)
SUPPLIER_TOP=
PO_TOP=
ITEM_TOP=
INVOICE_TOP=

# Request behaviour - keeps the connector inside the sandbox quota
SAP_PAGE_SIZE=          # records per HTTP page
SAP_FILTER_CHUNK=      # keys combined into one $filter (A or B or C ...)
SAP_USE_EXPAND=       # fetch supplier company/purch-org/text with $expand
SAP_REQUEST_DELAY=    # minimum seconds between SAP calls (0 to disable)
SAP_MAX_RETRIES=        # retries for temporary errors (spike arrest, 503, ...)
SAP_TIMEOUT=          # seconds before a SAP call is abandoned

# Incremental sync - only fetch records that are new/changed since the last run
INCREMENTAL=true          # false = behave like before (always fetch from the start)
FULL_REFRESH=false        # true  = ignore the stored watermarks for this run only
# SAP date field used for the watermark filter (check it on the API Business Hub page).
# type: date | datetime | datetimeoffset. If SAP rejects the filter the connector
# warns and falls back to a full fetch for that entity.
SUPPLIER_DATE_FIELD=CreationDate
SUPPLIER_DATE_TYPE=date
PO_DATE_FIELD=LastChangeDateTime
PO_DATE_TYPE=datetimeoffset

# Purchase orders are loaded in resumable batches (PO -> items -> invoices -> commit).
# PO_TOP = max POs per RUN (a run stops there and the next run continues);
# PO_BATCH = POs per committed batch.
PO_BATCH=
